---
import type { NavKey } from '../nav';
import { siteBasePath } from '../paths';

interface Props {
  navKey: NavKey;
}

const { navKey } = Astro.props;

const githubRepoUrl = 'https://github.com/ysskrishna/google-sheets-tab-manager';
const googleMarketplaceUrl =
  'https://workspace.google.com/marketplace/app/sheets_tab_manager/430663965462';
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a class="brand" href={siteBasePath} aria-current={navKey === 'home' ? 'page' : undefined}>
      <img src={`${siteBasePath}assets/logos/icon48.png`} alt="" width="48" height="48" />
      <span>Sheets Tab Manager</span>
    </a>
    <button
      type="button"
      class="site-nav__toggle"
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Open menu"
    >
      <span class="site-nav__burger" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
    <nav class="site-nav" id="site-nav-menu" aria-label="Main">
      <div class="site-nav__ctas">
        <a
          class="site-nav__cta site-nav__cta--github"
          href={githubRepoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="site-nav__cta-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 496 512"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3.7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9 1.6 1 3.6.7 4.3-.7.7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3.7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3.7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z"
            />
          </svg>
          <span>GitHub</span>
        </a>
        <a
          class="site-nav__cta site-nav__cta--sheets"
          href={googleMarketplaceUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="site-nav__cta-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path
              fill="currentColor"
              d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H5v-4h9v4zm0-6H5V7h9v4zm6 6h-5v-4h5v4zm0-6h-5V7h5v4z"
            />
          </svg>
          <span>Add to Google Sheets</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const MQ = '(max-width: 42rem)';

  function initSiteHeader() {
    const header = document.getElementById('site-header');
    const toggle = header?.querySelector<HTMLButtonElement>('.site-nav__toggle');
    const nav = document.getElementById('site-nav-menu');
    if (!header || !toggle || !nav) return;

    const mql = window.matchMedia(MQ);

    function setOpen(open: boolean) {
      header.classList.toggle('site-header--nav-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('site-nav-open-body', open && mql.matches);
    }

    function closeIfMobile() {
      if (mql.matches) setOpen(false);
    }

    toggle.addEventListener('click', () => {
      if (!mql.matches) return;
      const next = !header.classList.contains('site-header--nav-open');
      setOpen(next);
      if (next) {
        const first = nav.querySelector<HTMLAnchorElement>('a');
        first?.focus();
      }
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) closeIfMobile();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeIfMobile();
    });

    document.addEventListener(
      'click',
      (e) => {
        if (!mql.matches || !header.classList.contains('site-header--nav-open')) return;
        if (!header.contains(e.target as Node)) closeIfMobile();
      },
      true
    );

    mql.addEventListener('change', () => {
      if (!mql.matches) setOpen(false);
    });
  }

  initSiteHeader();
</script>
